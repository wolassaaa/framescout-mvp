{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://framescout.local/schemas/review-strategy.schema.json",
  "title": "FrameScout review strategy",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "version", "name", "note", "intent", "subjects", "signals", "decisionPolicy", "selectionGoal", "burstPolicy", "fallbackPolicy", "acceptanceExamples"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "$ref": "#/$defs/localizedText" },
    "note": { "$ref": "#/$defs/localizedText" },
    "intent": { "type": "string", "minLength": 12 },
    "subjects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedLabels", "minimumConfidence", "protectSmallSubjects", "protectedContexts"],
      "properties": {
        "allowedLabels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "minimumConfidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "protectSmallSubjects": { "type": "boolean" },
        "protectedContexts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus", "exposure", "face", "aesthetic"],
      "properties": {
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "regionPriority", "reviewBelow", "rejectBelow", "protectIntentionalMotion"],
          "properties": {
            "enabled": { "type": "boolean" },
            "regionPriority": { "type": "array", "items": { "enum": ["face", "subject", "global"] }, "uniqueItems": true },
            "reviewBelow": { "type": "number", "minimum": 0 },
            "rejectBelow": { "type": "number", "minimum": 0 },
            "protectIntentionalMotion": { "type": "boolean" }
          }
        },
        "exposure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "shadowClipReviewAbove", "highlightClipReviewAbove", "protectLowLight"],
          "properties": {
            "enabled": { "type": "boolean" },
            "shadowClipReviewAbove": { "type": "number", "minimum": 0, "maximum": 1 },
            "highlightClipReviewAbove": { "type": "number", "minimum": 0, "maximum": 1 },
            "protectLowLight": { "type": "boolean" }
          }
        },
        "face": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "checkEyes", "checkExpression", "minimumFacePixels", "closedEyesAction"],
          "properties": {
            "mode": { "enum": ["off", "optional", "required"] },
            "checkEyes": { "type": "boolean" },
            "checkExpression": { "type": "boolean" },
            "minimumFacePixels": { "type": "integer", "minimum": 0 },
            "closedEyesAction": { "enum": ["keep", "review", "reject"] }
          }
        },
        "aesthetic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "weight", "canHardReject"],
          "properties": {
            "mode": { "enum": ["off", "rank-within-group", "rank-within-project"] },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "canHardReject": { "const": false }
          }
        }
      }
    },
    "decisionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noAllowedSubject", "unreadablePreview", "hardRejectRequires", "humanDecisionWins", "ambiguousAction"],
      "properties": {
        "noAllowedSubject": { "$ref": "#/$defs/action" },
        "unreadablePreview": { "$ref": "#/$defs/action" },
        "hardRejectRequires": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "humanDecisionWins": { "const": true },
        "ambiguousAction": { "const": "review" }
      }
    },
    "selectionGoal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultTargetCount", "mode", "rankingScope", "diversity", "insufficientEligible", "preserveHumanDecisions"],
      "properties": {
        "defaultTargetCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "mode": { "const": "exact" },
        "rankingScope": { "const": "project" },
        "diversity": { "enum": ["burst-aware", "score-only"] },
        "insufficientEligible": { "const": "return-all-eligible" },
        "preserveHumanDecisions": { "const": true }
      }
    },
    "burstPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "protectBestPerGroup", "rankingSignals"],
      "properties": {
        "enabled": { "type": "boolean" },
        "protectBestPerGroup": { "type": "integer", "minimum": 0 },
        "rankingSignals": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "fallbackPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectDetectorUnavailable", "faceModelUnavailable", "aestheticModelUnavailable", "cloudUnavailable", "rawUploadAllowed"],
      "properties": {
        "subjectDetectorUnavailable": { "const": "review" },
        "faceModelUnavailable": { "const": "skip-face-signals" },
        "aestheticModelUnavailable": { "const": "preserve-original-order" },
        "cloudUnavailable": { "const": "use-local-signals" },
        "rawUploadAllowed": { "const": false }
      }
    },
    "acceptanceExamples": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "given", "expected", "reason", "requiredSignals"],
        "properties": {
          "case": { "type": "string", "minLength": 3 },
          "given": { "type": "string", "minLength": 8 },
          "expected": { "$ref": "#/$defs/action" },
          "reason": { "type": "string", "minLength": 8 },
          "requiredSignals": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  },
  "$defs": {
    "action": { "enum": ["keep", "review", "reject"] },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 2 },
        "en": { "type": "string", "minLength": 2 }
      }
    }
  }
}
