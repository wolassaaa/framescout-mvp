{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FrameScout",
  "version": "0.1.0",
  "identifier": "com.framescout.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FrameScout",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 760,
        "backgroundColor": "#0B0D10"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "nsis",
    "externalBin": ["binaries/framescout-local-service"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
